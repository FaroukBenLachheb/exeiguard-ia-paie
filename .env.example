# .env.example — variables d'environnement (dev / docker-compose.dev.yml)
#
# Copier en .env et adapter si besoin. Les valeurs par defaut ci-dessous
# (definies aussi dans docker-compose.dev.yml) suffisent pour le dev local.

POSTGRES_USER=exeiguard
POSTGRES_PASSWORD=exeiguard_paie
POSTGRES_DB=exeiguard_poc
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Utilisee par les services (orchestrateur, etc.) pour se connecter a
# PostgreSQL via docker-compose ; voir db/database.py pour la valeur par
# defaut construite a partir des variables POSTGRES_* si absente.
# DATABASE_URL=postgresql+psycopg2://exeiguard:exeiguard_paie@postgres:5432/exeiguard_poc

# LLM (Ollama, servi par le service "llm-server" sur la VM GPU cible OVH /
# NVIDIA L4 24 Go — remplace le plan initial llama.cpp CPU-only). Endpoint
# compatible OpenAI sur http://${OLLAMA_HOST}:${OLLAMA_PORT}/v1 (voir
# llm/README.md).
OLLAMA_HOST=llm-server
OLLAMA_PORT=11434

# Fallback d'extraction EVP quand le parsing direct echoue / score de
# confiance insuffisant (voir source_extraction dans db/models.py).
OLLAMA_MODEL_FALLBACK=mistral:7b-instruct-q4_K_M

# Raisonnement compliance / RAG (Moteur Compliance & Validation).
OLLAMA_MODEL_COMPLIANCE=qwen2.5:14b-instruct-q4_K_M
